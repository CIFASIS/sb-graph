/* Model for causalization testing =============================================
 * Description: implicit 1D advection model, with N algebraic loops.
   a[i] and b[i] must be simultaneously solved.
--------------------------------------------------------------------------------

model Test1D
  constant Integer N=100;
  Real a[N],b[N],x[N];
equation
  a[1]+b[1]=1;
  b[1]-a[1]=2*x[1]-1;
  
  for i in 2:N loop
    a[i]+b[i]=b[i-1];
    b[i]-a[i]= 2*x[i]-x[i-1];
  end for;    
  
  for i in 1:N loop
    der(x[i])=a[i];
  end for;
end Test1D;
==============================================================================*/

V0 = 0;
E0 = 0;
V1 = V0+100;
V2 = V1+100;
V3 = V2+100;
V4 = V3+1;
V5 = V4+1;
V6 = V5+99;
V7 = V6+99;
V8 = V7+100;
E1 = E0+1;
offM11 = V0 - E0;
offM21 = V3 - E0;
E2 = E1+1;
offM12 = V1 - E1;
offM22 = V3 - E1;
E3 = E2+1;
offM13 = V0 - E2;
offM23 = V4 - E2;
E4 = E3+1;
offM14 = V1 - E3;
offM24 = V4 - E3;
E5 = E4+99;
offM15 = V0 - E4 + 1;
offM25 = V5 - E4;
E6 = E5+99;
offM16 = V1 - E5;
offM26 = V5 - E5;
E7 = E6+99;
offM17 = V1 - E6 + 1;
offM27 = V5 - E6;
E8 = E7+99;
offM18 = V0 - E7 + 1;
offM28 = V6 - E7;
E9 = E8+99;
offM19 = V1 - E8 + 1;
offM29 = V6 - E8;
E10 = E9+100;
offM110 = V0 - E9;
offM210 = V7 - E9;
E11 = E10+100;
offM111 = V2 - E10;
offM211 = V7 - E10;

F = {[V3+1:1:V4], [V4+1:1:V5], [V5+1:1:V6], [V6+1:1:V7], [V7+1:1:V8]};
U = {[V0+1:1:V1], [V1+1:1:V2], [V2+1:1:V3]};

V: F \/ U
Vmap: <<{[V0+1:1:V1]} -> |0*x+1|, {[V1+1:1:V2]} -> |0*x+2|, {[V2+1:1:V3]} -> |0*x+3|, {[V3+1:1:V4]} -> |0*x+4|, {[V4+1:1:V5]} -> |0*x+5|, {[V5+1:1:V6]} -> |0*x+6|, {[V6+1:1:V7]} -> |0*x+7|, {[V7+1:1:V8]} -> |0*x+8|>>
map1: <<{[E0+1:1:E1]} -> |1*x+offM11|, {[E1+1:1:E2]} -> |1*x+offM12|, {[E2+1:1:E3]} -> |1*x+offM13|, {[E3+1:1:E4]} -> |1*x+offM14|, {[E4+1:1:E5]} -> |1*x+offM15|, {[E5+1:1:E6]} -> |1*x+offM16|, {[E6+1:1:E7]} -> |1*x+offM17|, {[E7+1:1:E8]} -> |1*x+offM18|, {[E8+1:1:E9]} -> |1*x+offM19|, {[E9+1:1:E10]} -> |1*x+offM110|, {[E10+1:1:E11]} -> |1*x+offM111|>>
map2: <<{[E0+1:1:E1]} -> |1*x+offM21|, {[E1+1:1:E2]} -> |1*x+offM22|, {[E2+1:1:E3]} -> |1*x+offM23|, {[E3+1:1:E4]} -> |1*x+offM24|, {[E4+1:1:E5]} -> |1*x+offM25|, {[E5+1:1:E6]} -> |1*x+offM26|, {[E6+1:1:E7]} -> |1*x+offM27|, {[E7+1:1:E8]} -> |1*x+offM28|, {[E8+1:1:E9]} -> |1*x+offM29|, {[E9+1:1:E10]} -> |1*x+offM210|, {[E10+1:1:E11]} -> |1*x+offM211|>>
Emap: <<{[E0+1:1:E1]} -> |0*x+1|, {[E1+1:1:E2]} -> |0*x+2|, {[E2+1:1:E3]} -> |0*x+3|, {[E3+1:1:E4]} -> |0*x+4|, {[E4+1:1:E5]} -> |0*x+5|, {[E5+1:1:E6]} -> |0*x+6|, {[E6+1:1:E7]} -> |0*x+7|, {[E7+1:1:E8]} -> |0*x+8|, {[E8+1:1:E9]} -> |0*x+9|, {[E9+1:1:E10]} -> |0*x+10|, {[E10+1:1:E11]} -> |0*x+11|>>
X: F
Y: U;

match(
  V: F \/ U
  Vmap: <<{[V0+1:1:V1]} -> |0*x+1|, {[V1+1:1:V2]} -> |0*x+2|, {[V2+1:1:V3]} -> |0*x+3|, {[V3+1:1:V4]} -> |0*x+4|, {[V4+1:1:V5]} -> |0*x+5|, {[V5+1:1:V6]} -> |0*x+6|, {[V6+1:1:V7]} -> |0*x+7|, {[V7+1:1:V8]} -> |0*x+8|>>
  map1: <<{[E0+1:1:E1]} -> |1*x+offM11|, {[E1+1:1:E2]} -> |1*x+offM12|, {[E2+1:1:E3]} -> |1*x+offM13|, {[E3+1:1:E4]} -> |1*x+offM14|, {[E4+1:1:E5]} -> |1*x+offM15|, {[E5+1:1:E6]} -> |1*x+offM16|, {[E6+1:1:E7]} -> |1*x+offM17|, {[E7+1:1:E8]} -> |1*x+offM18|, {[E8+1:1:E9]} -> |1*x+offM19|, {[E9+1:1:E10]} -> |1*x+offM110|, {[E10+1:1:E11]} -> |1*x+offM111|>>
  map2: <<{[E0+1:1:E1]} -> |1*x+offM21|, {[E1+1:1:E2]} -> |1*x+offM22|, {[E2+1:1:E3]} -> |1*x+offM23|, {[E3+1:1:E4]} -> |1*x+offM24|, {[E4+1:1:E5]} -> |1*x+offM25|, {[E5+1:1:E6]} -> |1*x+offM26|, {[E6+1:1:E7]} -> |1*x+offM27|, {[E7+1:1:E8]} -> |1*x+offM28|, {[E8+1:1:E9]} -> |1*x+offM29|, {[E9+1:1:E10]} -> |1*x+offM210|, {[E10+1:1:E11]} -> |1*x+offM211|>>
  Emap: <<{[E0+1:1:E1]} -> |0*x+1|, {[E1+1:1:E2]} -> |0*x+2|, {[E2+1:1:E3]} -> |0*x+3|, {[E3+1:1:E4]} -> |0*x+4|, {[E4+1:1:E5]} -> |0*x+5|, {[E5+1:1:E6]} -> |0*x+6|, {[E6+1:1:E7]} -> |0*x+7|, {[E7+1:1:E8]} -> |0*x+8|, {[E8+1:1:E9]} -> |0*x+9|, {[E9+1:1:E10]} -> |0*x+10|, {[E10+1:1:E11]} -> |0*x+11|>>
  X: F
  Y: U
  , 1
);
