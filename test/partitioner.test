// Partitioner test with SEGFAULT error

map1 = <<{[4000:1:4999]} -> |x-3000|, {[5000:1:5999]} -> |x-2000|, {[6000:1:6999]} -> |x-6000|, {[7000:1:7999]} -> |x-5000|>>;
lh = <<{[4000:1:4999]} -> |x-3000|, {[5000:1:5999]} -> |x-2000|, {[6000:1:6999]} -> |x-6000|, {[7000:1:7999]} -> |x-5000|>>;
map2 = <<{[4000:1:4999]} -> |x-4000|, {[5000:1:5999]} -> |x-5000|, {[6000:1:6999]} -> |x-5000|, {[7000:1:7999]} -> |x-6000|>>;
rh = <<{[4000:1:4999]} -> |x-4000|, {[5000:1:5999]} -> |x-5000|, {[6000:1:6999]} -> |x-5000|, {[7000:1:7999]} -> |x-6000|>>;

map1 == lh;
map2 == rh;
