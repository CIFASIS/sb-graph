/* Test for empty SBG ==========================================================
 * Simple file to test how an empty SBG is evaluated. Currently, it gives a
   SEGFAULT. SOLVED. 
==============================================================================*/

N = 100000;

V1 = N;

scc(
  V: {[1:1:V1]}
  Vmap: <<{[1:1:V1]} -> |0*x+1|>> 
  mapB: <<>>
  mapD: <<>>
  Emap: <<>>);
