/* Example for tearing testing =================================================
 * Description: tearing of a SBG with a large number of small SCCs.
   The corresponding model has N algebraic loops.
   Ua[i] and Uc[i] must be simultaneously solved.
--------------------------------------------------------------------------------

model TestRL1
  constant Integer N = 10000;
  Real iL[N], Ua[N], Uc[N];
  parameter Real Ra = 1, Rb = 1, Rc = 1, L = 1;
equation
  der(iL[1]) = U0 - Ua[1];
  for i in 2:N loop
    L*der(iL[i]) = Uc[i-1] - Ua[i];
  end for;
  for i in 1:N-1 loop
    Ua[i] = Rb*iL[i+1] + Uc[i]*Rb/Rc;
  end for;
  for i in 1:N-1 loop
    iL[i] = Ua[i]/Ra + Uc[i]/Rc + iL[i+1];
  end for;
  iL[N] = Ua[N]/Ra + Uc[N]/Rc;
  Ua[N] = Uc[N]*Rb/Rc;
end TestRL1;
==============================================================================*/

mfvs(
  V: {[1:1], [4:10002], [30003:40001], [60000:69998], [70000:70001]}
  Vmap: <<{[1:1]} -> |1|, {[4:10002]} -> |3|, {[30003:40001]} -> |6|
    , {[60000:69998]} -> |9|, {[70000:70000]} -> |11|, {[70001:70001]} -> |12|>>
  mapB: <<{[2:2]} -> |30003|, {[10004:20001]} -> |x+20000|, {[20002:20002]} -> |x+49999|
    , {[20004:30002]} -> |x+39996|, {[40002:50000]} -> |x+19998|
    , {[50001:59999]} -> |x-19998|, {[69999:69999]} -> |70001|, {[70002:70002]} -> |70000|>>
  mapD: <<{[2:2], [70002:70002]} -> |x-1|, {[10004:20002]} -> |x-10000|
    , {[20004:30002]} -> |x-20000|, {[40002:50000]} -> |x-9999|
    , {[50001:59999]} -> |x+9999|, {[69999:69999]} -> |x+1|>>
  Emap: <<{[2:2]} -> |1|, {[10004:20001]} -> |2|, {[20002:20002]} -> |3|
    , {[20004:30002]} -> |4|, {[40002:50000]} -> |5|, {[50001:59999]} -> |6|
    , {[69999:69999]} -> |7|, {[70002:70002]} -> |8|>>
);
