/* Test for parsing/evaluation of map expressions ==============================
 * Simple file to test the parser and evaluator. 
   WARNING: if this file is modified, the corresponding logs in parse/gt_data
   and eval/gt_data must be updated.
==============================================================================*/

{[1:1:10]} -> |1*x+0|;
{[1:2:10]} -> |1/2*x+1/2|;

image({[1:1:10]} -> |1*x+0|);
image({[1:2:50]} -> |2*x+1|);
image({[1:3:50], [2:3:100]} -> |2*x+1|);
