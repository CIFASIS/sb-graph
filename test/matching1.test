/* Model for matching testing ==================================================
 * Description: model with a simple repetition of the form 1 - 11 - 2 - 12
   - ... - 10 - 20, when N=10.
--------------------------------------------------------------------------------

model matching1
  constant Integer N = 1000000;
  Real a[N];
equation
  a[1] = 0;
  for i in 2:N loop
    a[i-1] + a[i] = 0;
  end for;
end matching1;
==============================================================================*/

N = 1000000;

V1 = 1;
V2 = N-1+V1;
V3 = N+V2;

E1 = 1;
E2 = N-1+E1;
E3 = N-1+E2;

off1b = V1-E1; 
off2b = V2-E2;
off3b = V2-E3;

off1d = V3-E1-N+1;
off2d = V3-E2-1;
off3d = V3-E3;

F = {[1:1:V1], [V1+1:1:V2]};
U = {[V2+1:1:V3]};

V: F \/ U
Vmap: <<{[1:1:V1]} -> |0*x+1|, {[V1+1:1:V2]} -> |0*x+2|, {[V2+1:1:V3]} -> |0*x+3|>> 
map1: <<{[1:1:E1]} -> |1*x+off1b|, {[E1+1:1:E2]} -> |1*x+off2b|, {[E2+1:1:E3]} -> |1*x+off3b|>>
map2: <<{[1:1:E1]} -> |1*x+off1d|, {[E1+1:1:E2]} -> |1*x+off2d|, {[E2+1:1:E3]} -> |1*x+off3d|>>
Emap: <<{[1:1:E1]} -> |0*x+1|, {[E1+1:1:E2]} -> |0*x+2|, {[E2+1:1:E3]} -> |0*x+3|>>
X: F
Y: U;

match(
  V: F \/ U
  Vmap: <<{[1:1:V1]} -> |0*x+1|, {[V1+1:1:V2]} -> |0*x+2|, {[V2+1:1:V3]} -> |0*x+3|>> 
  map1: <<{[1:1:E1]} -> |1*x+off1d|, {[E1+1:1:E2]} -> |1*x+off2d|, {[E2+1:1:E3]} -> |1*x+off3d|>>
  map2: <<{[1:1:E1]} -> |1*x+off1b|, {[E1+1:1:E2]} -> |1*x+off2b|, {[E2+1:1:E3]} -> |1*x+off3b|>>
  Emap: <<{[1:1:E1]} -> |0*x+1|, {[E1+1:1:E2]} -> |0*x+2|, {[E2+1:1:E3]} -> |0*x+3|>>
  X: F
  Y: U
  , 1
);
