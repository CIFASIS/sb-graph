/* Model for matching testing ================================================
 * Description: SBG defined at the top-left of page 6 of "Efficient Matching
   in Large DAE Models". I'll add comments next to vertices and edges to
   indicate which elements of the picture they are referencing.
==============================================================================*/

N = 5;

V1 = 1;      // 1
V2 = N-1+V1; // [2:5]
V3 = 1+V2;   // 6
V4 = N-1+V3; // [7:10]
V5 = N-1+V4; // [11:14]
V6 = 1+V5;   // 15
V7 = N-1+V6; // [16:19]
V8 = 1+V7;   // 20

E1 = 1;      // 1 - 11
E2 = N-1+E1; // [2:5] - [11:14]
E3 = N-2+E2; // [2:4] - [12:14]
E4 = 1+E3;   // 5 - 15
E5 = 1+E4;   // 1 - 20
E6 = 1+E5;   // 6 - 15
E7 = N-1+E6; // [7:10] - 15
E8 = N-1+E7; // [7:10] - [16:19]

off1b = V5-E1-N+2;
off2b = V5-E2;
off3b = V5-E3;
off4b = V6-E4;
off5b = V8-E5;
off6b = V6-E6;
off7b = V6;
off8b = V7-E8;

off1d = V1-E1; 
off2d = V2-E2;
off3d = V2-E3-1;
off4d = V2-E4;
off5d = V1-E5;
off6d = V3-E6;
off7d = V4-E7;
off8d = V4-E8;

F = {[1:V4]};
U = {[V4+1:V8]};

V: F \/ U
Vmap: <<{[1:V1]} -> |0*x+1|, {[V1+1:V2]} -> |0*x+2|, {[V2+1:V3]} -> |0*x+3|
  , {[V3+1:V4]} -> |0*x+4|, {[V4+1:V5]} -> |0*x+5|, {[V5+1:V6]} -> |0*x+6|
  , {[V6+1:V7]} -> |0*x+6|, {[V7+1:V8]} -> |0*x+8|>>
map1: <<{[1:1:E1]} -> |1*x+off1d|, {[E1+1:1:E2]} -> |1*x+off2d|, {[E2+1:1:E3]} -> |1*x+off3d|
  , {[E3+1:1:E4]} -> |1*x+off4d|, {[E4+1:1:E5]} -> |1*x+off5d|, {[E5+1:1:E6]} -> |1*x+off6d|
  , {[E6+1:1:E7]} -> |1*x+off7d|, {[E7+1:1:E8]} -> |1*x+off8d|>>
map2: <<{[1:1:E1]} -> |1*x+off1b|, {[E1+1:1:E2]} -> |1*x+off2b|, {[E2+1:1:E3]} -> |1*x+off3b|
  , {[E3+1:1:E4]} -> |1*x+off4b|, {[E4+1:1:E5]} -> |1*x+off5b|, {[E5+1:1:E6]} -> |1*x+off6b|
  , {[E6+1:1:E7]} -> |0*x+off7b|, {[E7+1:1:E8]} -> |1*x+off8b|>>
Emap: <<{[1:1:E1]} -> |0*x+1|, {[E1+1:1:E2]} -> |0*x+2|, {[E2+1:1:E3]} -> |0*x+3|
  , {[E3+1:1:E4]} -> |0*x+4|, {[E4+1:1:E5]} -> |0*x+5|, {[E5+1:1:E6]} -> |0*x+6|
  , {[E6+1:1:E7]} -> |0*x+7|, {[E7+1:1:E8]} -> |0*x+8|>>
X: F
Y: U;

match(
  V: F \/ U
  Vmap: <<{[1:V1]} -> |0*x+1|, {[V1+1:V2]} -> |0*x+2|, {[V2+1:V3]} -> |0*x+3|
    , {[V3+1:V4]} -> |0*x+4|, {[V4+1:V5]} -> |0*x+5|, {[V5+1:V6]} -> |0*x+6|
    , {[V6+1:V7]} -> |0*x+6|, {[V7+1:V8]} -> |0*x+8|>>
  map1: <<{[1:1:E1]} -> |1*x+off1d|, {[E1+1:1:E2]} -> |1*x+off2d|, {[E2+1:1:E3]} -> |1*x+off3d|
    , {[E3+1:1:E4]} -> |1*x+off4d|, {[E4+1:1:E5]} -> |1*x+off5d|, {[E5+1:1:E6]} -> |1*x+off6d|
    , {[E6+1:1:E7]} -> |1*x+off7d|, {[E7+1:1:E8]} -> |1*x+off8d|>>
  map2: <<{[1:1:E1]} -> |1*x+off1b|, {[E1+1:1:E2]} -> |1*x+off2b|, {[E2+1:1:E3]} -> |1*x+off3b|
    , {[E3+1:1:E4]} -> |1*x+off4b|, {[E4+1:1:E5]} -> |1*x+off5b|, {[E5+1:1:E6]} -> |1*x+off6b|
    , {[E6+1:1:E7]} -> |0*x+off7b|, {[E7+1:1:E8]} -> |1*x+off8b|>>
  Emap: <<{[1:1:E1]} -> |0*x+1|, {[E1+1:1:E2]} -> |0*x+2|, {[E2+1:1:E3]} -> |0*x+3|
    , {[E3+1:1:E4]} -> |0*x+4|, {[E4+1:1:E5]} -> |0*x+5|, {[E5+1:1:E6]} -> |0*x+6|
    , {[E6+1:1:E7]} -> |0*x+7|, {[E7+1:1:E8]} -> |0*x+8|>>
  X: U
  Y: F
, 1);
