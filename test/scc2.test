/* Model for SCC testing =======================================================
 * Description: model with a simple repetitive path of the form
   2 -> 3 -> ... -> 11, and a branch in the middle 6 -> 1 for N = 10.
   Meant to test the implementation of MinReach.
==============================================================================*/

N = 1000000;
N2 = 500000;

V1 = 1;
V2 = N+V1;

E1 = 1;
E2 = N-1+E1;

off1b = V2-E1-N2;
off2b = V2-E2-1;

off1d = V1-E1;
off2d = V2-E2;

V: {[1:1:V1], [V1+1:1:V2]}
Vmap: <<{[1:1:V1]} -> |0*x+1|, {[V1+1:1:V2]} -> |0*x+2|>>
mapB: <<{[1:1:E1]} -> |1*x+off1b|, {[E1+1:1:E2]} -> |1*x+off2b|>>
mapD: <<{[1:1:E1]} -> |1*x+off1d|, {[E1+1:1:E2]} -> |1*x+off2d|>>
Emap: <<{[1:1:E1]} -> |0*x+1|, {[E1+1:1:E2]} -> |0*x+2|>>;

scc(
  V: {[1:1:V1], [V1+1:1:V2]}
  Vmap: <<{[1:1:V1]} -> |0*x+1|, {[V1+1:1:V2]} -> |0*x+2|>> 
  mapB: <<{[1:1:E1]} -> |1*x+off1b|, {[E1+1:1:E2]} -> |1*x+off2b|>>
  mapD: <<{[1:1:E1]} -> |1*x+off1d|, {[E1+1:1:E2]} -> |1*x+off2d|>>
  Emap: <<{[1:1:E1]} -> |0*x+1|, {[E1+1:1:E2]} -> |0*x+2|>>
);
