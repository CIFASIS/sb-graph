# Directories 
EVAL_DIR    := eval
VISIT_DIR   := $(EVAL_DIR)/visitors

# Build folders
create-folders::
	@mkdir -p $(BUILD_DIR)/$(EVAL_DIR)
	@mkdir -p $(BUILD_DIR)/$(EVAL_DIR)/visitors

# Sources
EVAL_SRC := \
	$(VISIT_DIR)/program_visitor.cpp \
	$(VISIT_DIR)/autom_impl_visitor.cpp \
	$(VISIT_DIR)/stm_visitor.cpp \
	$(VISIT_DIR)/eval_expr.cpp \
	$(VISIT_DIR)/eval_le.cpp \
	$(VISIT_DIR)/eval_rat.cpp \
	$(VISIT_DIR)/eval_int.cpp \
	$(VISIT_DIR)/eval_nat.cpp \
	$(EVAL_DIR)/defs.cpp

# Objects
EVAL_OBJ=$(addprefix $(BUILD_DIR)/, $(EVAL_SRC:.cpp=.o))

# Compilation
$(BUILD_DIR)/%.o: %.cpp | create-folders
	$(CC) $(INCLUDES) $(CXXFLAGS) -MM -MT $@ -MF $(patsubst %.o,%.d,$@) $<
	$(CC) $(INCLUDES) -c $< -o $@ $(CXXFLAGS)

# Binary
EVAL_BIN := $(BIN_DIR)/sbg-eval

# Binary compilation
EVAL_BIN_FLAGS := -Llib/ -lsbgraph

$(EVAL_BIN): $(LIB_SBGRAPH)
	$(CXX) $(CXXFLAGS) -o $(EVAL_BIN) $(INCLUDES) $(EVAL_DIR)/main.cpp $(EVAL_BIN_FLAGS)

all: $(EVAL_BIN)
