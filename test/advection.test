/* Graph originated from the model:
model advection
  parameter Real alpha=0.5,mu=1000;
  constant Integer N = 100;
  Real u[N];
  initial algorithm
  for i in 1:N/3 loop
    u[i]:=1;
  end for;

equation
  der(u[1])=(-u[1]+1)*N-mu*u[1]*(u[1]-alpha)*(u[1]-1);
  for j in 2:N loop
    der(u[j])=(-u[j]+u[j-1])*N-mu*u[j]*(u[j]-alpha)*(u[j]-1);
  end for;
end advection;
*/

V0 = 0;
E0 = 0;
V1 = V0+100;
V2 = V1+1;
V3 = V2+99;
E1 = E0+1;
offM11 = r(V0,1) - r(E0,1);
offM21 = r(V1,1) - r(E0,1);
E2 = E1+99;
offM12 = r(V0,1) - r(E1,1) + 2;
offM22 = r(V2,1) - r(E1,1);

V: {[V0+1:1:V1] , [V1+1:1:V2] , [V2+1:1:V3]}
Vmap: <<{[V0+1:1:V1]} -> |0*x+1 |, {[V1+1:1:V2]} -> |0*x+2 |, {[V2+1:1:V3]} -> |0*x+3|>>
map1: <<{[E0+1:1:E1]} -> |1*x+offM11 |, {[E1+1:1:E2]} -> |1*x+offM12|>>
map2: <<{[E0+1:1:E1]} -> |1*x+offM21 |, {[E1+1:1:E2]} -> |1*x+offM22|>>
Emap: <<{[E0+1:1:E1]} -> |0*x+1 |, {[E1+1:1:E2]} -> |0*x+2|>>;

matchSCC(
  V: {[V0+1:1:V1] , [V1+1:1:V2] , [V2+1:1:V3]}
  Vmap: <<{[V0+1:1:V1]} -> |0*x+1 |, {[V1+1:1:V2]} -> |0*x+2 |, {[V2+1:1:V3]} -> |0*x+3|>>
  map1: <<{[E0+1:1:E1]} -> |1*x+offM11 |, {[E1+1:1:E2]} -> |1*x+offM12|>>
  map2: <<{[E0+1:1:E1]} -> |1*x+offM21 |, {[E1+1:1:E2]} -> |1*x+offM22|>>
  Emap: <<{[E0+1:1:E1]} -> |0*x+1 |, {[E1+1:1:E2]} -> |0*x+2|>>
  , 1);
