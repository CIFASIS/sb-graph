/* Model for topological sorting testing =======================================
 * Description: model with edges i - i+10 for i \in [1:10] when N = 10.
==============================================================================*/

N = 1000000;

V1 = N;
V2 = N+V1;

E1 = N;

off1b = V2-E1;

off1d = V1-E1;

V: {[1:1:V1], [V1+1:1:V2]}
Vmap: <<{[1:1:V1]} -> |0*x+1|, {[V1+1:1:V2]} -> |0*x+2|>>
mapB: <<{[1:1:E1]} -> |1*x+off1b|>>
mapD: <<{[1:1:E1]} -> |1*x+off1d|>>
Emap: <<{[1:1:E1]} -> |0*x+1|>>;

sort(
  V: {[1:1:V1], [V1+1:1:V2]}
  Vmap: <<{[1:1:V1]} -> |0*x+1|, {[V1+1:1:V2]} -> |0*x+2|>>
  mapB: <<{[1:1:E1]} -> |1*x+off1b|>>
  mapD: <<{[1:1:E1]} -> |1*x+off1d|>>
  Emap: <<{[1:1:E1]} -> |0*x+1|>>
);
