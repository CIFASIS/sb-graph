/* Example for tearing testing =================================================
 * Description: tearing of a SBG with a large SCC.
   The corresponding model has a large algebraic loop of size k*N.
   iR[i] and iR[i+1] can be computed out of each other.
   uL[i] and uL[i+1] can be computed out of each other.
--------------------------------------------------------------------------------

model TestRL3
  constant Integer N=10000;
  Real iL[N],iR[N],uL[N];
  parameter Real L=1,R=1,L1=1,U=1,R0=1;
equation
  for i in 1:N loop
    L*der(iL[i])=uL[i];
  end for;  
  for i in 1:N-1 loop
    iR[i]-iR[i+1]-iL[i]=0;
    uL[i]-uL[i+1]-R*iR[i+1]=0;
  end for;
  U-uL[1]-R*iR[1]=0;
  uL[N]-(iR[N]-iL[N])*R0=0;
end TestRL3;
==============================================================================*/

mfvs(
  V: {[1:10000], [30000:39998], [49998:59996], [69997:69998]}
  Vmap: <<{[1:10000]} -> |1|, {[30000:39998]} -> |4|, {[49998:59996]} -> |6|
    , {[69997:69997]} -> |9|, {[69998:69998]} -> |10|>>
  mapB: <<{[10001:10001]} -> |x+59996|, {[10002:20000]} -> |x+39996|
    , {[20001:29998], [59997:59997]} -> |x+10000|, {[29999:29999]} -> |x+39999|
    , {[39999:49996]} -> |x-9998|, {[49997:49997]} -> |x+20001|, {[59998:69995]} -> |x-10000|
    , {[69996:69996]} -> |30000|, {[69999:69999]} -> |59996|>>
  mapD: <<{[10001:20000]} -> |x-10000|, {[20001:29999], [39999:49997]} -> |x+9999|
    , {[59997:69995]} -> |x-9999|, {[69996:69996]} -> |x+1|, {[69999:69999]} -> |x-1|>>
  Emap: <<{[10002:20000]} -> |1|, {[10001:10001]} -> |2|, {[20001:29998]} -> |3|
    , {[29999:29999]} -> |4|, {[39999:49996]} -> |5|, {[49997:49997]} -> |6|
    , {[59998:69995]} -> |7|, {[59997:59997]} -> |8|, {[69996:69996]} -> |9|, {[69999:69999]} -> |10|>>
);
