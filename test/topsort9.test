/* Model for topological sorting testing =======================================
 * Description: 2D model of a SBG with a single hyperrectangle without
   dependencies.
 * Motivation: to sort advection2D the repetition invokes MinVertexTS, and
   doesn't sort this SBG correctly. SOLVED.
============================================================================= */

dims = 2;

V: {[120:120]x[121:128], [121:121]x[120:128], [122:128]x[120:128]}
Vmap: <<{[120:120]x[121:128]} -> |22|22|, {[121:121]x[120:128]} -> |22|22|, {[122:128]x[120:128]} -> |22|22|>>
mapB: <<>>
mapD: <<>>
Emap: <<>>;

sort(
  V: {[120:120]x[121:128], [121:121]x[120:128], [122:128]x[120:128]}
  Vmap: <<{[120:120]x[121:128]} -> |22|22|, {[121:121]x[120:128]} -> |22|22|, {[122:128]x[120:128]} -> |22|22|>>
  mapB: <<>>
  mapD: <<>>
  Emap: <<>>
);
