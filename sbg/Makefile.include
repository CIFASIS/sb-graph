# Directories
SBG_DIR  := sbg

# Build folders
create-folders::
	@mkdir -p $(BUILD_DIR)/$(SBG_DIR)

# Sources
SBG_SRC := \
	$(SBG_DIR)/sbg_algorithms.cpp \
	$(SBG_DIR)/sbg.cpp \
	$(SBG_DIR)/af_pwmap.cpp \
	$(SBG_DIR)/pw_map.cpp \
	$(SBG_DIR)/af_map.cpp \
	$(SBG_DIR)/map.cpp \
	$(SBG_DIR)/multidim_lexp.cpp \
	$(SBG_DIR)/lexp.cpp \
	$(SBG_DIR)/af_set.cpp \
	$(SBG_DIR)/set.cpp \
	$(SBG_DIR)/multidim_inter.cpp \
	$(SBG_DIR)/interval.cpp \
	$(SBG_DIR)/rational.cpp \
	$(SBG_DIR)/natural.cpp

# Objects
SBG_OBJ := $(addprefix $(BUILD_DIR)/, $(SBG_SRC:.cpp=.o))

# Compilation
$(BUILD_DIR)/%.o: %.cpp | create-folders
	$(CC) $(INCLUDES) $(CXXFLAGS) -MM -MT $@ -MF $(patsubst %.o,%.d,$@) $<
	$(CC) $(INCLUDES) -c $< -o $@ $(CXXFLAGS)
