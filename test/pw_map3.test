/* Test for parsing/evaluation of PWMap expressions ============================
 * Simple file to test the parser and evaluator, in 3D. 
   WARNING: if this file is modified, the corresponding logs in parse/gt_data
   and eval/gt_data must be updated.
==============================================================================*/

dims = 3;

<<>>;

combine(<<{[1:1:10] x [1:1:10] x [1:1:10], [1:1:10] x [20:3:30] x [20:3:30]} -> |1*x+0|1*x+0|1*x+0|, {[1:1:10] x
[20:3:30] x [35:5:50], [35:5:50] x [35:5:50] x [20:3:30]} -> |3*x+0|3*x+0|1*x+1|>>, <<{[1:1:20]
x [1:1:20] x [1:1:20]} -> |1*x+1|1*x+0|1*x+0|>>);
