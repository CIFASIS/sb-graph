// Test consisting of only set expressions
// !!! If this file is modified the corresponding SBG.log file
//     in all the gt_data directories should be modified.

#{[1:1:100], [200:3:500]}

isEmpty({[1:5:100]});
isEmpty({});

minElem({[500:3:1000], [1:1:100]});

maxElem({[500:3:1000], [1:1:100]});

// Intersection

({[1000:1:1200]} /\ {[400:5:1000]});

({[1:5:100], [200:2:400]} /\ {[1:1:100],[200:1:400]});

({[1:3:4], [4:2:100]} /\ {[0:1:2]});

({[0:1:9],[10:5:199],[200:1:400]} /\ {[0:1:15],[35:1:60],[70:1:80]});

// Difference

({[50:1:150], [300:1:500]} \ {[1:1:100], [101:3:300]});

({[1:1:2], [3:1:100]} \ {[3:1:100]});

({[50:1:150], [300:1:500]} \ { [101:2:300]}); 

({[1:1:2], [3:1:100]} \ {[50:2:100]});

// Union

({} \/ {[1:1:100]});

({[2:2:200]} \/ {});

({[1:1:100], [500:2:1000]} \/ {[500:1:1000], [1400:1:10000]});

({[1:1:100], [500:2:1000]} \/ {[1005:1:2000]});

({[1:1:100], [101:1:300]} \/ {[50:1:150], [300:2:500]});

({[1:1:100], [150:1:250], [450:2:600]} \/ {[200:1:300], [425:1:430], [550:2:1000]});
