// Test consisting of only set expressions
// !!! If this file is modified the corresponding SBG.log file
//     in all the gt_data directories should be modified.


// Intersection

({} /\ {[1:1:100]});

({[1:1:100]} /\ {});

({[1:1:100]} /\ {[200:1:500]});

({[200:1:500]} /\ {[1:1:100]});

({[200:1:500]} /\ {[1:1:300]});

({[200:1:500]} /\ {[1:1:300],[450:1:500]});

({[1:1:100], [200:1:400]} /\ {[400:1:1000]});

({[400:1:1000]} /\ {[1:1:100], [200:1:400]});

({[1000:1:1200]} /\ {[400:1:1000]});

({[1:1:100], [200:1:400]} /\ {[200:1:400], [1:1:100]});

({[1:1:99], [100:1:100]} /\ {[0:1:2]});

({[1:1:1], [2:1:2], [3:1:3], [4:1:4], [5:1:5], [6:1:6], [7:1:7], [8:1:100]}
/\ {[3:1:5], [7:1:8]});

// Difference

({[50:1:150], [300:1:500]} \ {[1:1:100], [101:1:300]});

({[1:1:2], [3:1:100]} \ {[3:1:100]});

({[50:1:150], [300:1:500]} \ { [101:1:300]});

({[1:1:2], [3:1:100]} \ {[50:1:100]});

// Union

({} \/ {[1:1:100]});

({[2:2:200]} \/ {});

({[1:1:100], [500:1:1000]} \/ {[500:1:1000], [1400:1:10000]});

({[1:1:100], [500:1:1000]} \/ {[1005:1:2000]});

({[1:1:100], [101:1:300]} \/ {[50:1:150], [300:1:500]});

({[1:1:100], [150:1:250], [450:1:600]} \/ {[200:1:300], [425:1:430], [550:1:1000]});
